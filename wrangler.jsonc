{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "api.foodiesfinds.com/*",
      "zone_name": "foodiesfinds.com"
    }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://pub-017886dc539b41789e7c76de04239c5d.r2.dev"
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  "r2_buckets": [
    {
      "binding": "IMAGE_BUCKET",
      "bucket_name": "recipe-images"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // TODO: replace with the id printed by `wrangler hyperdrive create`
      // (see README's Hyperdrive setup section) before deploying this branch.
      "id": "<HYPERDRIVE_ID>"
    }
  ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
